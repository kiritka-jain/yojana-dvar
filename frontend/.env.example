# Yojana Dvar Frontend Environment Variables Example
# For local development:
VITE_API_BASE_URL=http://localhost:8000

# Firebase Auth Configuration (Optional for dev fallback):
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=yojana-dvar.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=yojana-dvar
VITE_FIREBASE_STORAGE_BUCKET=yojana-dvar.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
